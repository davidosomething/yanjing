{
  "compilerOptions": {
    "target": "ES2015",
    "module": "commonjs",
    "rootDir": "src",
    "strict": true,
    "noEmit": true,
    "removeComments": false,
    "lib": ["ES2015"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
